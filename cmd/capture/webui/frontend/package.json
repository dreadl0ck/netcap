{
  "name": "netcap-webui",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n ui,next -c blue,green \"pnpm --filter @dreadl0ck/netcap-ui dev\" \"next dev\"",
    "build": "pnpm --filter @dreadl0ck/netcap-ui build && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@dreadl0ck/netcap-ui": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@fontsource/roboto-mono": "^5.2.8",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "echarts": "^6.0.0",
    "next": "16.1.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-syntax-highlighter": "^16.1.0",
    "swr": "^2.3.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "baseline-browser-mapping": "^2.9.11",
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
