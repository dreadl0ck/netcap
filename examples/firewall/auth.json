{
  "scope": {"tenant": "example", "app": "web", "environment": "lab", "target": "edge"},
  "origin": "https://firewall.example.test",
  "static": [
    {"tokenEnv": "FIREWALL_READER_TOKEN", "principal": {"id": "reader", "grants": [
      {"scope": {"tenant": "example", "app": "web", "environment": "lab", "target": "edge"}, "actions": ["read", "metrics"]}
    ]}},
    {"tokenEnv": "FIREWALL_OPERATOR_TOKEN", "principal": {"id": "operator", "grants": [
      {"scope": {"tenant": "example", "app": "web", "environment": "lab", "target": "edge"}, "actions": ["read", "author", "evaluate", "deploy", "rollback"]}
    ]}}
  ]
}
