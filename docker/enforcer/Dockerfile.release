FROM alpine:3.23.2@sha256:865b95f46d98cf867a156fe4a135ad3fe50d2056aa3f25ed31662dff6da4eb62
ARG VERSION
ARG REVISION
LABEL org.opencontainers.image.version=$VERSION org.opencontainers.image.revision=$REVISION org.opencontainers.image.licenses="GPL-3.0-only"
RUN apk add --no-cache iproute2-minimal=6.17.0-r0 nftables=1.1.5-r2 && mkdir -p /var/lib/netcap-enforcer /run/netcap-enforcer && chmod 700 /run/netcap-enforcer && apk info -v > /etc/netcap-enforcer-packages.txt
COPY netcap-firewall-enforcer /netcap-firewall
COPY LICENSE /LICENSE
COPY legal /legal
COPY entrypoint.sh /entrypoint.sh
USER 0:0
ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
CMD ["--help"]
